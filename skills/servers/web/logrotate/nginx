# Rotates every day, empty or not, so no line outlives 30 days.
/var/log/nginx/*.log {
        daily
        missingok
        rotate 28
        maxage 28
        compress
        delaycompress
        ifempty
        create 640 nginx adm
        sharedscripts
        postrotate
                if [ -f /run/nginx.pid ]; then
                        kill -USR1 `cat /run/nginx.pid`
                fi
        endscript
}
